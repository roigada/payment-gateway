@gateway = http://localhost:8080
@bank = http://localhost:8787
@orderServiceCredential = {{$dotenv ORDER_SERVICE_CREDENTIAL}}

### Gateway health
GET {{gateway}}/healthz

### Gateway readiness
GET {{gateway}}/readyz

### Gateway metrics
GET {{gateway}}/metrics

### Mock Bank docs
GET {{bank}}/docs

### Authorize a Payment
# @name authorize
POST {{gateway}}/v1/payments
Authorization: Bearer {{orderServiceCredential}}
Content-Type: application/json
Idempotency-Key: demo-authorize-order-1001

{
  "order_id": "order-1001",
  "customer_id": "customer-501",
  "amount": 1299,
  "card": {
    "number": "4111111111111111",
    "cvv": "123",
    "expiry_month": 12,
    "expiry_year": 2030
  }
}

### Idempotency replay for the Authorize request
POST {{gateway}}/v1/payments
Authorization: Bearer {{orderServiceCredential}}
Content-Type: application/json
Idempotency-Key: demo-authorize-order-1001

{
  "order_id": "order-1001",
  "customer_id": "customer-501",
  "amount": 1299,
  "card": {
    "number": "4111111111111111",
    "cvv": "123",
    "expiry_month": 12,
    "expiry_year": 2030
  }
}

### Capture the Authorized Payment
# @name capture
POST {{gateway}}/v1/payments/{{authorize.response.body.$.payment.id}}/capture
Authorization: Bearer {{orderServiceCredential}}
Idempotency-Key: demo-capture-order-1001

### Fetch the Payment
GET {{gateway}}/v1/payments/{{authorize.response.body.$.payment.id}}
Authorization: Bearer {{orderServiceCredential}}

### Search Payments
GET {{gateway}}/v1/payments?order_id=order-1001&customer_id=customer-501
Authorization: Bearer {{orderServiceCredential}}

### Authorize a Declined Payment
POST {{gateway}}/v1/payments
Authorization: Bearer {{orderServiceCredential}}
Content-Type: application/json
Idempotency-Key: demo-authorize-declined-order-1002

{
  "order_id": "order-1002",
  "customer_id": "customer-502",
  "amount": 1299,
  "card": {
    "number": "5555555555554444",
    "cvv": "789",
    "expiry_month": 9,
    "expiry_year": 2030
  }
}
