{
	http_port 8080
	https_port 8443

	# These ceilings intentionally leave one second beyond the gateway's
	# configured HTTP timeouts, so the gateway remains the time-policy authority.
	servers {
		timeouts {
			read_body 16s
			read_header 6s
			write 16s
			idle 61s
		}
	}
}

(gateway) {
	reverse_proxy payment-gateway:8080 {
		transport http {
			dial_timeout 3s
			response_header_timeout 16s
			keepalive 61s
		}
	}
}

http://localhost:8080 {
	redir https://localhost:8443{uri} 308
}

https://localhost:8443 {
	# Match HTTP_MAX_REQUEST_BODY_BYTES in compose.yaml. Caddy returns 413 before
	# proxying any request body larger than the gateway's 64 KiB policy.
	request_body {
		max_size 65536
	}

	handle /api/v1/* {
		import gateway
	}

	handle /healthz {
		import gateway
	}

	handle /readyz {
		import gateway
	}

	handle {
		respond "not found" 404
	}
}
