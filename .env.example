# Generate a local throwaway credential with:
# go run ./gateway/cmd/service-credential -hmac-key "$SERVICE_CREDENTIAL_HMAC_KEY"
SERVICE_CREDENTIAL_HMAC_KEY=replace-with-base64url-encoded-32-byte-key
ORDER_SERVICE_CREDENTIALS=replace-with-generated-digest=payments:read+payments:write
ORDER_SERVICE_CREDENTIAL=replace-with-raw-credential-held-by-the-order-service
